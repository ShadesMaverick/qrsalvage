# Normalise line endings in the repository to LF, regardless of the platform a contributor
# works on. Without this, a Windows checkout commits CRLF and every pull request from a Linux
# machine shows the whole file as changed.
* text=auto eol=lf

# Binary, never touched
*.png binary
*.jpg binary
*.jpeg binary
*.npy binary

# PowerShell wants CRLF on Windows; the gate hook is Windows-only anyway.
*.ps1 text eol=crlf

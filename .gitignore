# Python
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Scratch output of a run -- intermediate results, never fixtures
out/
*.grid.json

# Local Claude Code settings
CLAUDE.local.md
.claude/settings.local.json

# IDE
.idea/
*.egg-info/

# Private test cases: real photographs and their results never leave the machine.
# The public corpus in fixtures/ is synthetic -- see scripts/make_fixtures.py
fixtures-local/

# Logo drafts: not final, and watermarked by the generator.
# The finished logo goes to docs/ once it exists.
idea_for_icon/

# Build artefacts
dist/
build/
idea.png

# The built site and the download cache of its runtime: both reproducible from
# scripts/build_site.py, both far too large for the history.
site/
vendor-cache/

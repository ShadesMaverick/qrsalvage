# Python
.venv/
# The second interpreter, kept because the CI lint job runs on 3.12 and numpy 2.5 refuses to
# install below it -- so a whole class of type error is invisible in .venv and only shows up
# there. Same requirements, different Python; see CLAUDE.md.
.venv312/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Scratch output of a run -- intermediate results, never fixtures
out/
*.grid.json

# Local Claude Code settings
CLAUDE.local.md
.claude/settings.local.json

# The running note of what is left to do by hand -- account chores, a postal address, DNS.
# None of that belongs in a public repository.
NOTE.md

# IDE
.idea/
*.egg-info/

# Private test cases: real photographs and their results never leave the machine.
# The public corpus in fixtures/ is synthetic -- see scripts/make_fixtures.py
fixtures-local/

# Logo drafts: not final, and watermarked by the generator.
# The finished logo goes to docs/ once it exists.
idea_for_icon/

# Build artefacts
dist/
build/
idea.png

# The built site and the download cache of its runtime: both reproducible from
# scripts/build_site.py, both far too large for the history.
site/
vendor-cache/
.worktrees/
